<properties>
	
	<property name="addAgentSession">
		<![CDATA[
			insert into agent_session (sessionId,agentId,createTime,domain,title,useId) values(#[sessionid],#[agentid],#[createtime],#[domain],#[title],#[useid])
		]]>
	</property>
	<property name="deleteByKey">
		<![CDATA[
			delete from agent_session where sessionId=?
		]]>
	</property>

    <property name="deleteAgentSessionMessageByKey">
        <![CDATA[
			delete from agent_session_message where sessionId=?
		]]>
    </property>
    <property name="deleteAgentSessionMessageRefByKey">
        <![CDATA[
			delete from agent_session_message_ref where sessionId=?
		]]>
    </property>
    

    
	<property name="updateAgentSession">
		<![CDATA[
			update agent_session set sessionId=#[sessionid],agentId=#[agentid],createTime=#[createtime],domain=#[domain],title=#[title],useId=#[useid] where sessionId=#[sessionid]
		]]>
	</property>
	<property name="selectById">
		<![CDATA[
			select * from agent_session where sessionId=?
		]]>
	</property>
    <property name="existAgentSession">
        <![CDATA[
			select count(1) as sessionCount from agent_session where sessionId=?
		]]>
    </property>
    
	<property name="queryListAgentSession">
		<![CDATA[
			select * from agent_session where 1=1
			#if($agentid && !$agentid.equals(""))
				and agentId =#[agentid]		
			#end
			#if($userId && !$userId.equals(""))
				and userId =#[userId]		
			#end
			#if($domain && !$domain.equals(""))
				and domain =#[domain]		
			#end		
			#if($domains)
				and domain in  ( 
                  #foreach($d in $domains) 
                        #if($foreach.index > 0),#end #[domains[$foreach.index]] 
                  #end
              ) 	
			#end
			#if($title && !$title.equals(""))
				and title like #[title]	
			#end	  
			#if($timeStart )
                and $timeConditionField >= #[timeStart]
            #end
            #if($timeEnd )
                and $timeConditionField <= #[timeEnd]
            #end
            #if($sortKey && !$sortKey.equals(""))
                order by $sortKey #if($sortDesc)desc#else asc#end
            #end

		]]>
	</property>

    <property name="queryListSessionMessages">
        <![CDATA[
			select *  from agent_session_message where sessionId=? order by createTime,seqNo asc

		]]>
    </property>

    <property name="queryListAgentSessionMessages">
        <![CDATA[
			select *  from agent_session_message where sessionId=? and agentid=? order by createTime,seqNo asc

		]]>
    </property>


    
</properties>